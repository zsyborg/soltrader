# Runtime
NODE_ENV=development
TRADING_MODE=paper
LOG_LEVEL=info
API_PORT=8787

# Solana cluster: devnet for development; mainnet-beta for production
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_WALLET_ADDRESS=

# Market data: simulator is safe default. Jupiter is real quote data where the configured endpoint supports the cluster.
QUOTE_PROVIDER=simulator
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=

# Strategy
MIN_PROFIT_BPS=30
MAX_SLIPPAGE_BPS=20
MIN_LIQUIDITY_USD=10000
MAX_TRADE_USD=100
MAX_DAILY_LOSS_USD=25
OPPORTUNITY_TTL_MS=1000

# Execution safety
LIVE_TRADING_ENABLED=false

# Local persistence
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/soltrader
REDIS_URL=redis://localhost:6379

# Production: use a dedicated/private RPC and an external signer/custody system.
# SOLANA_CLUSTER=mainnet-beta
# SOLANA_RPC_URL=https://your-private-mainnet-rpc
# SOLANA_WS_URL=wss://your-private-mainnet-rpc
