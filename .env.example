# Runtime
NODE_ENV=development
TRADING_MODE=paper
LOG_LEVEL=info

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=

# Strategy
MIN_PROFIT_BPS=30
MAX_SLIPPAGE_BPS=20
MIN_LIQUIDITY_USD=10000
MAX_TRADE_USD=100
MAX_DAILY_LOSS_USD=25
OPPORTUNITY_TTL_MS=1000

# Execution safety
LIVE_TRADING_ENABLED=false

# Optional persistence (not required by the first milestone)
DATABASE_URL=
REDIS_URL=
