# Runtime
NODE_ENV=development
TRADING_MODE=paper
LOG_LEVEL=info
API_PORT=8787

# Solana cluster: devnet for development; mainnet-beta for production
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Strategy
MIN_PROFIT_BPS=30
MAX_SLIPPAGE_BPS=20
MIN_LIQUIDITY_USD=10000
MAX_TRADE_USD=100
MAX_DAILY_LOSS_USD=25
OPPORTUNITY_TTL_MS=1000

# Execution safety
LIVE_TRADING_ENABLED=false

# Local persistence
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/soltrader
REDIS_URL=redis://localhost:6379

# Production: replace only the cluster/RPC and provide a dedicated signer through the production secret manager.
# SOLANA_CLUSTER=mainnet-beta
# SOLANA_RPC_URL=https://your-private-mainnet-rpc
# SOLANA_WS_URL=wss://your-private-mainnet-rpc
